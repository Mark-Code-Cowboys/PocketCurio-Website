---
/**
 * Inline SVG illustrations of the souvenir kinds the app's collection picker
 * offers (lib/core/utils/labels.dart): keychain, magnet, shotGlass, patch,
 * ornament, pin, spoon, sticker, postcard, other. Cream + curio violet + brass,
 * so they read as one set next to the app screenshots.
 */
interface Props {
  kind: 'keychain' | 'magnet' | 'shotGlass' | 'patch' | 'ornament' | 'pin' | 'spoon' | 'sticker' | 'postcard' | 'other';
  size?: number;
  class?: string;
}

const { kind, size = 64, class: className = '' } = Astro.props;

const V = '#7a4e7e';   // curio violet
const VD = '#61395f';  // violet deep
const VL = '#d9cbda';  // violet light
const C = '#f6f1e7';   // cream
const CD = '#e0d6c4';  // cream shadow
const B = '#b8873a';   // brass
const BD = '#8f6624';  // brass deep

const art: Record<Props['kind'], string> = {
  keychain: `
    <circle cx="16" cy="16" r="9" fill="none" stroke="${B}" stroke-width="3.2"/>
    <circle cx="16" cy="16" r="9" fill="none" stroke="${BD}" stroke-width="1" opacity="0.5"/>
    <circle cx="24" cy="23" r="2.2" fill="${B}"/>
    <circle cx="28" cy="27" r="2.2" fill="${B}"/>
    <path d="M30 29 H54 a4 4 0 0 1 4 4 V50 a4 4 0 0 1 -4 4 H30 L23 41.5 Z" fill="${C}"/>
    <path d="M30 29 H54 a4 4 0 0 1 4 4 V50 a4 4 0 0 1 -4 4 H30 L23 41.5 Z" fill="none" stroke="${CD}" stroke-width="1.2"/>
    <circle cx="30" cy="41.5" r="2.4" fill="${V}"/>
    <rect x="36" y="37" width="17" height="4" rx="2" fill="${V}"/>
    <rect x="36" y="44" width="11" height="2.6" rx="1.3" fill="${VL}"/>
  `,
  magnet: `
    <rect x="9" y="12" width="46" height="42" rx="6" fill="${CD}"/>
    <rect x="7" y="10" width="46" height="42" rx="6" fill="${C}"/>
    <rect x="12" y="15" width="36" height="22" rx="3" fill="${V}"/>
    <path d="M12 37 L22 25 L29 32 L36 22 L48 37 Z" fill="${VD}"/>
    <circle cx="40" cy="21" r="3" fill="${C}"/>
    <rect x="15" y="41" width="30" height="4.4" rx="2.2" fill="${V}"/>
    <rect x="15" y="47" width="18" height="2.6" rx="1.3" fill="${VL}"/>
  `,
  shotGlass: `
    <path d="M20 10 H44 L40 52 H24 Z" fill="${C}" opacity="0.9"/>
    <path d="M20 10 H44 L40 52 H24 Z" fill="none" stroke="${CD}" stroke-width="1.4"/>
    <path d="M24 44 H40 L39.2 52 H24.8 Z" fill="${CD}"/>
    <path d="M22.4 26 H41.6 L40.9 34 H23.1 Z" fill="${V}"/>
    <rect x="27" y="29" width="10" height="2.2" rx="1.1" fill="${C}"/>
    <path d="M23 12 L26.5 46" stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity="0.7"/>
  `,
  patch: `
    <path d="M32 8 L54 15 V33 C54 45 44 53 32 57 C20 53 10 45 10 33 V15 Z" fill="${V}"/>
    <path d="M32 12 L50 18 V33 C50 43 42 50 32 53.5 C22 50 14 43 14 33 V18 Z" fill="none" stroke="${C}" stroke-width="1.6" stroke-dasharray="2.6 2.2"/>
    <path d="M32 21 L35 28 L42.5 28.6 L37 33.6 L38.6 41 L32 37.3 L25.4 41 L27 33.6 L21.5 28.6 L29 28 Z" fill="${B}"/>
    <rect x="22" y="44" width="20" height="3" rx="1.5" fill="${C}"/>
  `,
  ornament: `
    <path d="M32 4 V9" stroke="${BD}" stroke-width="2" stroke-linecap="round"/>
    <circle cx="32" cy="4.5" r="2.6" fill="none" stroke="${BD}" stroke-width="1.6"/>
    <rect x="26" y="9" width="12" height="7" rx="2" fill="${B}"/>
    <circle cx="32" cy="36" r="21" fill="${V}"/>
    <path d="M11.5 32 C18 26 46 26 52.5 32 C46 38 18 38 11.5 32 Z" fill="${C}"/>
    <path d="M13 40 C20 36 44 36 51 40" stroke="${VL}" stroke-width="2" fill="none" stroke-linecap="round"/>
    <circle cx="24" cy="26" r="3" fill="#fff" opacity="0.55"/>
  `,
  pin: `
    <circle cx="30" cy="30" r="21" fill="${VD}"/>
    <circle cx="30" cy="30" r="17" fill="${V}"/>
    <path d="M30 17 L33.6 25.5 L42.9 26.3 L35.9 32.3 L38 41.4 L30 36.6 L22 41.4 L24.1 32.3 L17.1 26.3 L26.4 25.5 Z" fill="${C}"/>
    <circle cx="30" cy="30" r="21" fill="none" stroke="${B}" stroke-width="2.4"/>
    <path d="M47 42 L58 53" stroke="${BD}" stroke-width="2.6" stroke-linecap="round"/>
    <circle cx="47" cy="42" r="3" fill="${B}"/>
  `,
  spoon: `
    <ellipse cx="32" cy="47" rx="10.5" ry="12" fill="${B}"/>
    <ellipse cx="30" cy="45" rx="6.5" ry="8" fill="${C}" opacity="0.55"/>
    <path d="M30.5 36 C29.5 28 29.5 20 30 12 H34 C34.5 20 34.5 28 33.5 36 Z" fill="${B}"/>
    <path d="M32 3 L37.5 7 V13 L32 17 L26.5 13 V7 Z" fill="${B}"/>
    <path d="M32 6 L35 8.2 V11.8 L32 14 L29 11.8 V8.2 Z" fill="${V}"/>
    <rect x="30.2" y="18" width="1.4" height="12" rx="0.7" fill="#fff" opacity="0.4"/>
  `,
  sticker: `
    <rect x="10" y="10" width="44" height="44" rx="11" fill="${C}"/>
    <rect x="10" y="10" width="44" height="44" rx="11" fill="none" stroke="${CD}" stroke-width="1.4"/>
    <circle cx="32" cy="30" r="12" fill="${V}"/>
    <path d="M22 41 L32 24 L42 41 Z" fill="${VD}"/>
    <circle cx="36" cy="26" r="2.4" fill="${C}"/>
    <path d="M54 39 C48 40 41 46 40 54 L54 54 Z" fill="#fff"/>
    <path d="M54 39 C48 40 41 46 40 54" fill="none" stroke="${CD}" stroke-width="1.2"/>
    <path d="M40 54 C41 47 47 41 54 39" fill="${VL}" opacity="0.5"/>
  `,
  postcard: `
    <rect x="6" y="14" width="52" height="36" rx="3" fill="${C}"/>
    <rect x="6" y="14" width="52" height="36" rx="3" fill="none" stroke="${CD}" stroke-width="1.4"/>
    <rect x="10" y="18" width="24" height="18" rx="2" fill="${V}"/>
    <path d="M10 36 L18 27 L23 32 L28 26 L34 36 Z" fill="${VD}"/>
    <circle cx="29" cy="23" r="2.2" fill="${C}"/>
    <rect x="40" y="18" width="12" height="12" rx="1" fill="${B}" stroke="${C}" stroke-width="1.5" stroke-dasharray="1.5 1.5"/>
    <rect x="10" y="40" width="20" height="2.2" rx="1.1" fill="${VL}"/>
    <rect x="10" y="44" width="14" height="2.2" rx="1.1" fill="${VL}"/>
    <rect x="38" y="36" width="16" height="2.2" rx="1.1" fill="${VL}"/>
    <rect x="38" y="41" width="12" height="2.2" rx="1.1" fill="${VL}"/>
  `,
  other: `
    <path d="M18 50 H46 L44 58 H20 Z" fill="${B}"/>
    <rect x="16" y="46" width="32" height="5" rx="2" fill="${BD}"/>
    <circle cx="32" cy="29" r="20" fill="${VL}" opacity="0.55"/>
    <circle cx="32" cy="29" r="20" fill="none" stroke="${V}" stroke-width="1.6" opacity="0.5"/>
    <path d="M22 41 L32 27 L42 41 Z" fill="${V}"/>
    <path d="M28 41 L35 31 L42 41 Z" fill="${VD}"/>
    <circle cx="25" cy="22" r="1.6" fill="#fff"/>
    <circle cx="38" cy="17" r="1.3" fill="#fff"/>
    <circle cx="20" cy="31" r="1.2" fill="#fff"/>
    <circle cx="42" cy="26" r="1.5" fill="#fff"/>
  `,
};
---

<svg
  class={`souvenir ${className}`}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
  set:html={art[kind]}
/>
