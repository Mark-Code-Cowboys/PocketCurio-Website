---

<nav>
  <a href="/" class="logo">
    <img src="/favicon.svg" alt="" width="26" height="26" />
    Pocket<span>Curio</span>
  </a>
  <div class="nav-links">
    <a href="/#features">Features</a>
    <a href="/user-guide/">User Guide</a>
    <a href="/faq/">FAQ</a>
    <a href="/help/">Help</a>
    <a href="/#about">About</a>
    <a href="https://code-cowboys.com" class="nav-studio">Code Cowboys <i class="ti ti-external-link"></i></a>
    <a href="mailto:hello@code-cowboys.com" class="btn">Get in Touch</a>
  </div>
  <div class="hamburger" id="hamburger">
    <span></span><span></span><span></span>
  </div>
</nav>
<div class="mobile-menu" id="mobileMenu">
  <a href="/#features">Features</a>
  <a href="/user-guide/">User Guide</a>
  <a href="/faq/">FAQ</a>
  <a href="/help/">Help</a>
  <a href="/#about">About</a>
  <a href="https://code-cowboys.com">Code Cowboys</a>
  <a href="mailto:hello@code-cowboys.com">Get in Touch</a>
</div>

<style>
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 40px;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: rgba(253,248,250,0.94);
    backdrop-filter: blur(8px);
    z-index: 100;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 900;
    color: var(--text);
  }
  .logo img { border-radius: 6px; }
  .logo span { color: var(--curio); }

  .nav-links {
    display: flex;
    gap: 26px;
    align-items: center;
  }

  .nav-links a {
    font-size: 13px;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--curio); }
  .nav-links .btn { color: #fff; }
  .nav-studio { display: inline-flex; align-items: center; gap: 4px; }
  .nav-studio i { font-size: 13px; }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 4px;
  }
  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text-muted);
    border-radius: 2px;
  }

  .mobile-menu {
    display: none;
    flex-direction: column;
    background: var(--bg2);
    border-bottom: 1px solid var(--border);
  }
  .mobile-menu a {
    padding: 16px 20px;
    font-size: 14px;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--border);
  }
  .mobile-menu a:last-child { border-bottom: none; }
  .mobile-menu.open { display: flex; }

  @media (max-width: 768px) {
    nav { padding: 16px 20px; }
    .nav-links { display: none; }
    .hamburger { display: flex; }
  }
</style>

<script>
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobileMenu');
  hamburger?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('open');
  });
</script>
