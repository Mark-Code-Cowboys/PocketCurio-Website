<footer>
  <div class="inner footer-inner">
    <a href="/" class="logo">Pocket<span>Curio</span></a>
    <div class="footer-links">
      <a href="/#features">Features</a>
      <a href="/#privacy">Privacy</a>
      <a href="/#about">About</a>
      <a href="/privacy/">Privacy Policy</a>
      <a href="https://code-cowboys.com">Code Cowboys</a>
      <a href="https://tableencore.app">Table Encore</a>
      <a href="https://traceelements.app">Trace Elements</a>
      <a href="mailto:hello@code-cowboys.com">Contact</a>
    </div>
    <p>© 2026 <a href="https://code-cowboys.com" class="copy-link">Code Cowboys LLC</a> · Michigan</p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 28px 0;
    background: var(--bg2);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .logo {
    font-family: 'Playfair Display', serif;
    font-size: 16px;
    font-weight: 900;
    color: var(--text);
  }
  .logo span { color: var(--curio); }

  .footer-links {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
  }

  .footer-links a {
    font-size: 12px;
    color: var(--text-faint);
    transition: color 0.2s;
  }
  .footer-links a:hover { color: var(--text-dim); }

  footer p { font-size: 12px; color: var(--text-faint); }
  .copy-link { color: var(--text-dim); }
  .copy-link:hover { color: var(--curio); }

  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
