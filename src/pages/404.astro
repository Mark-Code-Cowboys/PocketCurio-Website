---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Souvenir from '../components/Souvenir.astro';
---

<Base title="Page Not Found — Pocket Curio" noindex={true}>
  <Nav />

  <section class="nf inner">
    <div class="nf-art"><Souvenir kind="postcard" size={72} /></div>
    <div class="section-label">404</div>
    <h1>This one fell behind the fridge.</h1>
    <p>The page you're looking for doesn't exist — maybe it moved, or the link had a typo.</p>
    <a href="/" class="btn">Back to the home page</a>
  </section>

  <Footer />
</Base>

<style>
  .nf {
    padding: 120px 40px;
    text-align: center;
    max-width: 560px;
  }
  .nf-art { margin-bottom: 18px; transform: rotate(-6deg); display: inline-block; }
  .nf h1 {
    font-family: 'Playfair Display', serif;
    font-size: 44px;
    font-weight: 900;
    color: var(--text);
    margin-bottom: 14px;
  }
  .nf p {
    font-size: 15px;
    color: var(--text-dim);
    font-weight: 300;
    margin-bottom: 30px;
  }
  @media (max-width: 768px) {
    .nf { padding: 80px 20px; }
    .nf h1 { font-size: 32px; }
  }
</style>
